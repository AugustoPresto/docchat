# ── LLM ───────────────────────────────────────────────────────────────────────
# Local / offline (default): Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b

# Cloud (optional): if a key is set it takes priority (Groq → OpenAI → Ollama)
# GROQ_API_KEY=gsk_your_key_here
# OPENAI_API_KEY=sk-proj-your_key_here

# ── Embeddings ────────────────────────────────────────────────────────────────
# fastembed (default): ONNX on CPU, no PyTorch — best for PCs without a GPU.
# sentence-transformers: PyTorch with CUDA/MPS detection
#   (pip install -r requirements-gpu.txt). Re-upload documents after switching.
EMBED_BACKEND=fastembed
EMBED_MODEL_CPU=sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_GPU=sentence-transformers/all-mpnet-base-v2
# Downloaded once, then reused offline
EMBED_CACHE_DIR=model_cache

# ── Storage (relative to backend dir) ────────────────────────────────────────
UPLOAD_DIR=uploads
VECTOR_STORE_DIR=vector_stores

# ── RAG ───────────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4

# ── Limits / public demo ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=100
# true = each browser sees only its own documents (anonymous, no login)
ISOLATE_CLIENTS=false
# Delete documents after N hours (0 = never)
DOC_TTL_HOURS=0
# Max documents per browser when ISOLATE_CLIENTS=true (0 = unlimited)
MAX_DOCS_PER_CLIENT=0
# ALLOWED_ORIGINS=["https://your-frontend.vercel.app"]
